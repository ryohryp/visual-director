{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/workspace?view=home" },
    { "src": "^/projects/([^/]+)/?$", "dest": "/api/workspace?view=project" },
    { "src": "^/projects/([^/]+)/anchors/?$", "dest": "/api/workspace?view=collection" },
    { "src": "^/projects/([^/]+)/anchors/([^/]+)/?$", "dest": "/api/workspace?view=anchor" },
    { "src": "^/projects/([^/]+)/assets/?$", "dest": "/api/workspace?view=collection" },
    { "src": "^/projects/([^/]+)/generations/?$", "dest": "/api/workspace?view=collection" },
    { "src": "^/api/projects/([^/]+)/overview/?$", "dest": "/api/overview?project_id=$1" },
    { "src": "^/api/projects/([^/]+)/asset/?$", "dest": "/api/asset?project_id=$1" },
    { "src": "^/api/projects/([^/]+)/anchor-detail/?$", "dest": "/api/anchor-detail?project_id=$1" },
    { "src": "^/dashboard/?$", "dest": "/api/dashboard" },
    { "src": "^/assets/?$", "dest": "/api/assets" },
    { "src": "^/anchor/?$", "dest": "/api/anchor" },
    { "src": "^/anchor-detail/?$", "dest": "/api/anchor-detail" },
    { "src": "^/overview/?$", "dest": "/api/overview" },
    { "src": "^/asset/?$", "dest": "/api/asset" },
    { "src": "^/mcp/?$", "dest": "/api/mcp" },
    { "src": "^/health/?$", "dest": "/api/health" },
    { "handle": "filesystem" }
  ]
}
