# Absolute path to a checkout of the canonical project repository.
BOTTOM_OF_THIRST_REPO_PATH=

# Optional JSON file for additional game projects. Paths inside it are relative to the config file.
VISUAL_DIRECTOR_PROJECTS_CONFIG=

# HTTP mode only. Stdio is the default and is used by MCP clients that spawn the server.
VISUAL_DIRECTOR_HOST=127.0.0.1
VISUAL_DIRECTOR_PORT=3000
